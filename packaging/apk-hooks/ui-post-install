#!/bin/sh
set -eu
[ -n "${IPKG_INSTROOT:-}" ] && exit 0
# Remove only HomeGate's obsolete catalog after the correct one is installed.
if [ -s /usr/lib/lua/luci/i18n/homegate.zh-cn.lmo ];then
 rm -f /usr/share/luci/i18n/homegate.zh-cn.lmo
fi
if [ -f /etc/uci-defaults/99-homegate-luci-languages ]; then
 sh /etc/uci-defaults/99-homegate-luci-languages
 rm -f /etc/uci-defaults/99-homegate-luci-languages
fi
if [ -f /etc/uci-defaults/luci-i18n-homegate-zh-cn ]; then
 sh /etc/uci-defaults/luci-i18n-homegate-zh-cn
 rm -f /etc/uci-defaults/luci-i18n-homegate-zh-cn
fi
rm -f /tmp/luci-indexcache
rm -rf /tmp/luci-modulecache
killall -HUP rpcd 2>/dev/null || true
