config homegate 'main'
	option enabled '1'
	option log_level 'info'
	option log_max_lines '1024'
	option access_enabled '0'
	option access_allow ''
	option access_deny ''
	option access_region ''
	option wol_interface 'br-lan'
	option last_wol_host ''
	option ddns_interval '300'
	option https_port '443'
	option http_port '0'
	option proxy_https_port '10443'
	option proxy_http_port '10080'
	option auto_firewall '1'
	option acme_email ''
	option acme_directory 'https://acme-v02.api.letsencrypt.org/directory'
	option renew_days '30'
	option version '@HOMEGATE_VERSION@'
