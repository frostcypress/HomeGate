#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

EXTRA_COMMANDS="network_changed"
EXTRA_HELP="\tnetwork_changed\tNotify the running daemon that WAN state changed"

# Normal OpenWrt upgrade semantics preserve rc.d enable/disable links when
# PKG_UPGRADE=1. Do not override rc.common enable(): opkg --force-reinstall is
# deliberately remove -> fresh install and should follow standard install semantics.

start_service() {
	# default_postinst invokes init start during a normal upgrade. Restore the
	# previous process-running state captured by the old package prerm. Remove the
	# one-shot marker here because start is the final lifecycle action.
	state="${HOMEGATE_PACKAGE_UPGRADE_STATE:-/tmp/.homegate-package-upgrade-state}"
	if [ -f "$state" ]; then
		if grep -qx 'was_running=0' "$state"; then
			rm -f "$state"
			return 0
		fi
		rm -f "$state"
	fi

	# Always declare the procd instance. rc.common implements `start` as a
	# complete service `set`; returning without an instance would replace a
	# currently-running service with an empty definition. Package postinst already
	# waits for a retiring old daemon before default_postinst reaches this point.

	[ "$(uci -q get homegate.main.enabled)" = "1" ] || return 0

	procd_open_instance
	procd_set_param command /usr/bin/homegate daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	[ -x /usr/bin/homegate ] && /usr/bin/homegate firewall-cleanup >/dev/null 2>&1 || true
}

reload_service() {
	if [ "$(uci -q get homegate.main.enabled)" != "1" ]; then
		stop
		return 0
	fi

	if pidof homegate >/dev/null 2>&1; then
		# Configuration changes remain a dedicated in-process event and keep the
		# daemon PID stable.
		procd_send_signal homegate '*' HUP
	else
		start
	fi
}

network_changed() {
	[ "$(uci -q get homegate.main.enabled)" = "1" ] || return 0
	if pidof homegate >/dev/null 2>&1; then
		# Stage 8 keeps WAN churn separate from configuration reload. SIGUSR1 is
		# consumed by the daemon scheduler as a deduplicated WANChanged event.
		procd_send_signal homegate '*' USR1
	else
		start
	fi
}

service_triggers() {
	procd_add_reload_trigger "homegate"
}
